# Copy to `.env` and fill locally. Never commit `.env`.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Compose Postgres (API runs on the host against published 5432)
POSTGRES_PASSWORD=postgres
TUSK_MIGRATE_PASSWORD=tusk_migrator
TUSK_APP_PASSWORD=tusk_app

DATABASE_URL=postgres://tusk_app:tusk_app@localhost:5432/tusk
DATABASE_MIGRATE_URL=postgres://tusk_migrator:tusk_migrator@localhost:5432/tusk

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536

ALLOW_SELF_TENANT=true
CORS_ORIGINS=http://localhost:3000
