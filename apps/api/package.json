{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/index.js",
    "lint": "oxlint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --env-file=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --config migrate.config.cjs --database-url-var DATABASE_MIGRATE_URL",
    "migrate:down": "node --env-file=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down --config migrate.config.cjs --database-url-var DATABASE_MIGRATE_URL",
    "migrate:create": "node --env-file=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create --config migrate.config.cjs --database-url-var DATABASE_MIGRATE_URL"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.2.12",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "node-pg-migrate": "^7.9.1",
    "oxlint": "^0.16.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
